# deploy/od-hub/.env.example — copy to deploy/od-hub/.env and fill in.
# Every variable below is read by the hub server (tools/od-hub/README.md,
# "Environment variables"). Compose-only knobs are marked [compose].
# Do not commit the filled-in .env: it holds OAuth and encryption secrets.

# --- Image / networking [compose] --------------------------------------------

# Image to run. Build locally with `docker compose build` (default tag), or
# point at a registry tag you pushed yourself.
OD_HUB_IMAGE=od-hub:local

# Host interface and port docker compose publishes. Keep 127.0.0.1 and put a
# TLS reverse proxy in front (README "Reverse proxy"); the hub speaks plain HTTP.
OD_HUB_BIND=127.0.0.1
OD_HUB_PUBLISH_PORT=18790

# Container memory cap and Node heap cap.
OD_HUB_MEM_LIMIT=512m
NODE_OPTIONS=--max-old-space-size=256

# --- Public URLs ---------------------------------------------------------------

# Origin clients use to reach the hub; written into every logged-in client's
# config.json as `apiUrl`. Must be the reverse-proxy origin, https in production.
HUB_PUBLIC_URL=https://hub.example.com

# Browser-facing origin for the console pages (invite landing, GitLab callback).
# `<HUB_CONSOLE_URL>/console/oauth/callback` must be registered as a redirect
# URI on the GitLab application. Leave empty to reuse HUB_PUBLIC_URL.
HUB_CONSOLE_URL=

# Origin written as `linkUrl` for model hosting. od-hub does not host models;
# leave empty (defaults to HUB_PUBLIC_URL) unless you run a Vela-compatible
# LLM gateway.
LLM_GATEWAY_URL=

# Desktop download page offered on invite pages and in `clientHints.downloadUrl`.
DOWNLOAD_URL=https://open-design.ai/download

# --- GitLab OAuth (required for real logins) -----------------------------------

# GitLab origin, e.g. https://gitlab.example.com (no trailing slash).
GITLAB_URL=

# OAuth application id/secret (README "GitLab OAuth application"). The
# application needs scopes `read_user read_api`, Device Authorization Grant
# enabled (GitLab 17.2+), and the console callback redirect URI. Omit the
# secret for a public (confidential = false) application.
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=

# Group Access Token (scope `api`, role Owner) used to add accepted invitees to
# the GitLab group. Unset = accepted invites exist in the hub mirror only and
# are dropped again on the next GitLab refresh of that user.
GITLAB_GROUP_TOKEN=

# Minimum GitLab access level that yields a workspace row (20 = Reporter,
# 30 = Developer, 40 = Maintainer).
GITLAB_MIN_ACCESS_LEVEL=20

# `top-level` (one workspace per top-level group) or `include-subgroups`.
GITLAB_WORKSPACE_GROUP_MODE=top-level

# --- Secrets and lifetimes -----------------------------------------------------

# REQUIRED in production: base64 of 32 random bytes (`openssl rand -base64 32`).
# AES-256-GCM key for GitLab tokens at rest. Unset = a process-lifetime key,
# so every restart forces every user to log in again. Never rotate without
# reading README "Rotating TOKEN_ENC_KEY".
TOKEN_ENC_KEY=

# Sliding lifetime of the odc_/odr_ client keys in days.
CONTROL_KEY_TTL_DAYS=30

# Lifetime of an invite landing link in hours (168 = 7 days).
INVITE_TTL_HOURS=168

# Presence lease lifetime in ms. Keep the default; the desktop heartbeats every
# 10 s. Lower it only for conformance runs.
PRESENCE_TTL_MS=30000

# --- Storage -------------------------------------------------------------------

# Root of the content-addressed blob store. The compose file mounts the data
# volume at /data; keep blobs next to the SQLite file so one snapshot backs up
# both, and keep them on the same filesystem (atomic rename).
BLOB_DIR=/data/blobs

# --- Invite mail (optional) ----------------------------------------------------

# smtp://[user:pass@]host[:port] (STARTTLS when offered) or smtps://... for
# implicit TLS. Unset = no mail; the landing URL is written to the log instead.
SMTP_URL=
# Sender address; defaults to od-hub@<console host>.
SMTP_FROM=
